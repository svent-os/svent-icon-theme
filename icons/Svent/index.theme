[Icon Theme]
Name=SventOS
Comment=SventOS red and graphite icons
Inherits=elementary-xfce-dark,Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/apps,scalable/devices,scalable/categories,scalable/mimetypes,scalable/actions,scalable/status

[scalable/places]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Places

[scalable/apps]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Applications

[scalable/devices]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[scalable/categories]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Categories

[scalable/mimetypes]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=MimeTypes

[scalable/actions]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions

[scalable/status]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Status
